# --- Editors / OS ---
.idea/
.vscode/
*.iml
*.iws
*.ipr
.eclipse/
.DS_Store

# --- Backend (Java / Maven) ---
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/.sts4-cache
backend/.settings
backend/.classpath
backend/.project
backend/.factorypath
backend/.springBeans
HELP.md

# Scratch profile overrides kept beside the pom, never the real configs in
# src/main/resources (see backend/.gitignore for why the anchoring matters).
backend/application-local.yml
backend/application-prod.yml
backend/application-*.local.yml

# --- Frontend (Node / Vite) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.eslintcache
frontend/.vite/
frontend/.vite-temp/

# --- Helm ---
# `helm dependency build` vendors upstream charts and writes a lock; both are
# reproducible from Chart.yaml and neither belongs in git.
chart/**/charts/
chart/**/Chart.lock
chart/**/tmpcharts*/
*.tgz

# --- Test output ---
# k6 writes these at the repo root; CI uploads them as artifacts instead.
k6-summary-*.json

# --- Secrets ---
.env
.env.*
!.env.example
